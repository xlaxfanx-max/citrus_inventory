# Development: set DJANGO_DEBUG=1. Production: set DJANGO_ENV=production and
# provide every security-sensitive value through the deployment secret store.
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
# Language for foreman accounts that have not picked one from the header toggle (en or es).
FOREMAN_DEFAULT_LANGUAGE=es

DJANGO_BEHIND_HTTPS_PROXY=0
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Container web process tuning. Start conservatively because OpenCV jobs are CPU-heavy.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
DJANGO_LOG_LEVEL=INFO

SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=lemon-photos
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-west-1

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=lemon-tracker@example.com
